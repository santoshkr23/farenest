PORT=3000
NODE_ENV=production
# Password for /admin. CHANGE THIS before deploying.
ADMIN_PASSWORD=change-me
# Default display currency (providers should be configured to return this currency)
DEFAULT_CURRENCY=INR
# Max time (ms) to wait for each provider before dropping it from results
PROVIDER_TIMEOUT_MS=12000

# ---- Accounts ----
# Public address of this server (used for the Google redirect), no trailing slash
PUBLIC_URL=https://api.your-domain.com
# Long random string used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile app link scheme(s) allowed to receive login tokens (matches "scheme" in mobile/app.json)
APP_SCHEMES=farenest
# iOS bundle id(s) allowed for Sign in with Apple (matches ios.bundleIdentifier in mobile/app.json)
APPLE_BUNDLE_IDS=com.farenest.app
# Other website addresses allowed to use this server (comma separated), e.g. your GitHub Pages site
ALLOWED_ORIGINS=https://santoshkr23.github.io
